QWidget, QToolTip, QStatusBar QToolTip, QComboBox:hover, QComboBox:focus, QPushButton:hover, QTextEdit:hover,
QPlainTextEdit:hover, QAbstractSpinBox:hover, QLabel:hover, QComboBox::item, QMenu::item, QAbstractView:hover,
QTableCornerButton::section, QHeaderView::section, QAbstractItemView::item:!selected:hover, QTextEdit:selected,
QPlainTextEdit:selected, QAbstractSpinBox:selected, QLineEdit:hover, QProgressBar::chunk, QGraphicsView:hover,
QWidget:disabled, QHeaderView::section:disabled {
    color: %1;
}

QComboBox::item:checked, LabelValue {
    color: %2;
}

QPushButton:hover, QComboBox:hover, QToolBox::tab:!selected:hover, QTabBar::tab:!selected:hover,
QTextEdit:hover, QScrollBar:hover, QMenu::item:selected, QComboBox::item:selected, QToolBox:selected,
QAbstractItemView::item:selected, QMainWindow::separator {
    border-color: %2;
}

QLineEdit:hover, QLineEdit:focus {
    border-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 %2,
        stop: 0.7 %2,
        stop: 0.99 transparent);
    border-right-color: transparent;
}

QWidget, QWidget:disabled, QWidget:item, QComboBox::drop-down, QToolBox::tab, QTabBar::tab, QSlider::groove,
QSlider::add-page:vertical, QSlider::sub-page:horizontal, QSlider::handle, QSplitter::handle,
QTableCornerButton::section, QHeaderView::section, QDateTimeEdit::drop-down,
QPushButton:pressed, QTabWidget::pane:selected, QToolTip, QTabWidget::pane {
    border-color: %3;
}

QScrollBar::handle, QScrollBar::handle:hover, QToolButton, QComboBox::drop-down, QComboBox::drop-down:hover {
    border-color: transparent;
}

QToolTip, QAbstractScrollArea, QAbstractSpinBox, QScrollBar, QToolBar QToolButton:checked, QGraphicsView:disabled,
QProgressBar:disabled, QPushButton:pressed, QComboBox QAbstractItemView, QComboBox:disabled,
QTableCornerButton::section, QTabBar::tab, QAbstractItemView:disabled, QToolBox::tab, QMenu::item, QComboBox::item,
QHeaderView::section, QSplitter::handle {
    background-color: %4;
}

QToolTip:disabled, QAbstractScrollArea:disabled, QAbstractSpinBox:disabled, QScrollBar:disabled, QToolBar QToolButton:disabled, QGraphicsView:disabled,
QProgressBar:disabled, QPushButton:pressed:disabled, QComboBox QAbstractItemView:disabled, QComboBox:disabled,
QTableCornerButton::section:disabled, QTabBar::tab:disabled, QAbstractItemView:disabled, QToolBox::tab:disabled, QMenu::item:disabled, QComboBox::item:disabled,
QHeaderView::section:disabled, QSplitter::handle:disabled {
    background-color: %5;
}

QLineEdit {
    border-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 %3,
        stop: 0.7 %3,
        stop: 0.99 transparent);
    border-right-color: transparent;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 %4,
        stop: 0.7 %4,
        stop: 0.99 transparent);
}

QLineEdit:disabled {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 %5,
        stop: 0.7 %5,
        stop: 0.99 transparent);
}

QPushButton, QComboBox, QToolBox::tab:selected, QScrollBar::handle, QSlider::handle, QSplitter::handle:hover,
QMainWindow::separator:hover, QMenu::separator, QTabBar::tab:selected {
    background-color: %6;
}

QProgressBar::chunk:disabled, QHeaderView::section:checked:disabled, QSlider::add-page:vertical:disabled, QSlider::sub-page:horizontal:disabled,
QPushButton:disabled, QTabBar::tab:selected:disabled, QHeaderView:disabled, QToolBox::tab:selected:disabled {
    background-color: %7;
}

QComboBox QAbstractItemView:alternate, QComboBox::indicator:alternate, QComboBox::item:alternate {
    background-color: %8;
}

QWidget::item:selected {
    background-color: %9;
}

QCheckBox, QGroupBox, QFrame, QRadioButton, QScrollArea > QWidget > QWidget,
QAbstractSpinBox:up-button, QAbstractSpinBox:down-button, ProgressBarBad::chunk,
QToolButton, QSizeGrip, QComboBox::indicator, QLabel, QSplitter, QStatusBar QLabel,
QMenuBar::item, QMenuBar::item:selected, Form {
    background-color: transparent;
    background: transparent;
}

QProgressBar {
    background-color: %10;
}

QProgressBar::chunk {
    background-color: %11;
}

/*
QComboBox QAbstractItemView {
    selection-background-color: %2;
}
*/
QTreeView, QListView, QTableView, QColumnView {
    selection-background-color: transparent;
    gridline-color: %3;
    background-color: %12;
}

QTableView#FreezeRow {
    background-color: %13;
}

QTableView::item, QListView::item {
    background-color: %14;
}

QTableView::item:alternate {
    background-color: %14;
}
/*
QTreeView::item:selected:active, QListView::item:selected:active,
QTableView::item:selected:active, QColumnView::item:selected:active,
QTreeView::item:selected:!active, QListView::item:selected:!active,
QTableView::item:selected:!active, QColumnView::item:selected:!active {
    selection-color: %1;
}
*/
QTreeView::item:!selected:hover, QListView::item:!selected:hover,
QTableView::item:!selected:hover, QColumnView::item:!selected:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0   %14,
        stop: 0.5 %15,
        stop: 1.0 %14);
}

QFrame#SubWindow {
    background-color: %16;
}

QFrame#FrameProfileBaseInfo {
    background-color: %17;
}

QFrame#FrameProfileMaximumInfo, QFrame#FrameProfileButtons {
    background-color: %12;
}

QFrame#FrameSelected, QFrame#FrameCategories, QFrame#FrameEditCategory {
    background-color: %18;
}

QWidget[accessibleName=TitleWindow] {
    background-color: %19;
    border-color: %2;
}

Form, .QWidget, QStackedWidget, QSlider, QHeaderView, Line, .QFrame {
    background-color: transparent;
    background: transparent;
    border-color: transparent;
}

FramelessWindow, QMessageBox, FramelessWindow:hover, QMessageBox:hover {
    background-color: %20;
    border-color: %2;
}
